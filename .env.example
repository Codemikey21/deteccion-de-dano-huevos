# Plantilla de variables de entorno.
# Copiar como .env y ajustar los valores locales. El archivo .env no se versiona.
#
# Copy-Item .env.example .env

# --- Cámara ---------------------------------------------------------------
# Índice del dispositivo de captura que usa OpenCV (0 = cámara por defecto).
CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS=30

# --- Rutas de datos -------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- Fases posteriores ----------------------------------------------------
# Estas variables se añadirán cuando la fase correspondiente las necesite
# (clave de Roboflow, configuración del backend, despliegue en EC2).

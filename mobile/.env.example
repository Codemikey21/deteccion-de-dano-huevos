# URL del backend FastAPI accesible desde el iPhone.
#
# Ejemplos:
# - Backend local en la misma Wi-Fi: http://192.168.1.100:8000
# - Backend remoto (AWS EC2):       http://YOUR_EC2_PUBLIC_IP:8080
#
# NO uses 127.0.0.1: en el teléfono apunta al propio dispositivo, no al PC.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Copiar a backend/.env y ajustar valores locales.
# No versionar backend/.env

# Ruta al checkpoint YOLOv8n@960 (relativa a la raíz del repo o absoluta)
MODEL_PATH=backend/models/best.pt

# Umbral de confianza para inferencia YOLO (valores iniciales configurables)
MODEL_CONFIDENCE=0.25

# Umbral mínimo de confianza para considerar un crack como válido en clasificación
CRACK_CONFIDENCE=0.25

# CORS — "*" solo desarrollo; restringir en producción (p. ej. origen Expo)
CORS_ORIGINS=*

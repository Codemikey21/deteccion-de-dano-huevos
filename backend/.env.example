# Copiar a backend/.env y ajustar valores locales.
# No versionar backend/.env

# Ruta al checkpoint YOLOv8n@960 (relativa a la raíz del repo o absoluta)
MODEL_PATH=backend/models/best.pt

# Umbral global YOLO — conserva candidatos para diagnóstico (no descartar demasiado pronto)
MODEL_CONFIDENCE=0.25

# Umbrales post-YOLO por clase (clasificación y detecciones filtradas)
EGG_CONFIDENCE=0.40
CRACK_CONFIDENCE=0.55

# CORS — "*" solo desarrollo; restringir en producción (p. ej. origen Expo)
CORS_ORIGINS=*

# Demo multi-huevo: una inferencia YOLO por imagen. false restaura single-egg + ROI.
ENABLE_MULTI_EGG=true
ENABLE_EGG_ROI_INFERENCE=true
DAMAGE_DARK_THRESHOLD=100
DAMAGE_MIN_CONTRAST=35
DAMAGE_MIN_AREA_RATIO=0.003
DAMAGE_MIN_LENGTH_RATIO=0.18
DAMAGE_MIN_ELONGATION=2.5
DAMAGE_INNER_SCALE=0.80
DAMAGE_ROI_MAX_SIDE=256

# Recuperación geométrica para huevos marrones sobre fondo neutro (demo).
# No es un detector general de objetos ni de pelotas blancas.
ENABLE_DEMO_LOCALIZATION=true
DEMO_MIN_SATURATION=65
DEMO_MIN_VALUE=65
DEMO_MIN_AREA_RATIO=0.003
DEMO_MAX_AREA_RATIO=0.45
DEMO_MAX_SIDE=640
DEMO_MAX_OBJECTS=32
# Contraste local: evita marcar como grieta una sombra suave de la cáscara.
DAMAGE_LOCAL_WINDOW_RATIO=0.25
DAMAGE_MARK_AREA_RATIO=0.015
